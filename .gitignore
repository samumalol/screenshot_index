# Local data — download MSD train/test, then run data/process_all_data.py
/data/*
!/data/README.md
!/data/process_all_data.py
!/data/building_index/
/data/building_index/**
!/data/building_index/index.html

# Leftover local pyarrow folder (use conda/pip pyarrow instead)
/python_packages/

# Official MSD paper clone (has its own .git). Clone it yourself if you need it:
#   git clone https://github.com/caspervanengelenburg/msd.git msd_code
/msd_code/

# Runtime / caches
/downloads/
/outputs/
.jupyter_config/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# Secrets and local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Dropbox
.dropbox
.dropbox.attr
Desktop.ini

# Published QC site (docs/) is generated by scripts/diagnostics/build_screenshot_index.py --web docs
!/docs/
